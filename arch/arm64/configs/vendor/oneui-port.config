
# Port de One UI: el HBM del FOD sigue al táctil (One UI no marca la capa FOD)
CONFIG_DRM_MSM_DSI_FOD_TOUCH_HBM=y
# Tiempo para que One UI pinte su luz antes de avisar al HAL de huella (fod_ui)
CONFIG_DRM_MSM_DSI_FOD_TOUCH_UI_DELAY_MS=100
# Posición del sensor (mm) para el bouncer de One UI: centro a 1810 px de 2340 (530 px del borde inferior, 33,86 mm
# con xdpi 397,57) → margen inferior 31,86 con alto 4; icono 10,80 como el A73
CONFIG_DRM_MSM_DSI_FOD_SENSOR_POSITION="31.86,0.00,9.00,4.00,14.80,14.80,10.80,10.80,5.00"
